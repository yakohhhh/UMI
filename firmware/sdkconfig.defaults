# ESP32-S3-WROOM-1-N16R8 (DevKitC-1 and, assumed, the Clip): 16 MB quad flash,
# 8 MB octal PSRAM. To confirm against the delivered modules.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The core task steps every 10 ms; a 1 ms tick keeps that period exact.
CONFIG_FREERTOS_HZ=1000

# BLE: NimBLE peripheral, one phone at a time, LE Secure Connections only
# (protocol/README.md §4: no legacy pairing), bonds kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# Session files are <8 hex digits>.umis: long file names on the FAT.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=32

# Flag signatures: deterministic ECDSA (RFC 6979), like the reference signer.
CONFIG_MBEDTLS_ECDSA_DETERMINISTIC=y
